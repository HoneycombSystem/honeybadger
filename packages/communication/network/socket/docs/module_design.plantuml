@startuml sokcet module desing

component socket {
    interface CloseableSocket{
        +close():bool
    }

    interface ReceiverSocket{
        +receive():void
    }

    interface SenderSocket{
        +send(Payload):void
    }

    interface ServerSocket{
        +bind(Address):bool
        +listen():bool
        +accept():bool
    }

    interface Socket extends CloseableSocket, ServerSocket, SenderSocket, ReceiverSocket
}

@endstartuml